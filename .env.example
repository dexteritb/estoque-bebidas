# Copie este arquivo para .env ao rodar localmente.
# No Render, essas variáveis são definidas automaticamente pelo render.yaml
# (exceto quando você optar por um Postgres externo — aí cole a connection
# string manualmente em DATABASE_URL nas configurações do serviço).

# Connection string do Postgres. Formato:
# postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=

# Porta em que o servidor escuta localmente (o Render define isso sozinho em produção)
PORT=3001

# Chave usada para assinar o cookie de sessão. Gere uma aleatória com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# "production" quando estiver atrás de HTTPS (Render já cuida disso sozinho
# via render.yaml). Em teste local, deixe "development".
NODE_ENV=development

# Defina como "disable" só se o seu Postgres local não usar SSL.
# PGSSL=disable
